@{
    ViewData["Title"] = "Admin Sign In";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-3">Admin Sign In</h4>
                <p class="text-muted small mb-3">Restricted access. Authorized administrators only.</p>

                <div id="adminLoginAlert" class="alert alert-danger d-none"></div>

                <form id="adminLoginForm">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" name="email" type="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" name="password" type="password" required />
                    </div>
                    <button class="btn btn-dark w-100" type="submit">Sign In as Admin</button>
                </form>

                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Need a new admin account?</span>
                    <button class="btn btn-outline-dark btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#adminRegisterPanel" aria-expanded="false" aria-controls="adminRegisterPanel">Admin Register</button>
                </div>

                <div class="collapse mt-3" id="adminRegisterPanel">
                    <form id="adminRegisterForm">
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input class="form-control" name="fullName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input class="form-control" name="email" type="email" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input class="form-control" name="password" type="password" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Admin Secret Key</label>
                            <input class="form-control" name="adminSecretKey" type="password" required />
                        </div>
                        <button class="btn btn-outline-dark w-100" type="submit">Create Admin Account</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("adminLoginForm");
            const adminRegisterForm = document.getElementById("adminRegisterForm");
            const alertBox = document.getElementById("adminLoginAlert");

            if (!form) return;

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                alertBox.classList.add("d-none");

                const payload = Object.fromEntries(new FormData(form).entries());

                try {
                    const response = await fetch("/api/auth/admin-login", {
                        method: "POST",
                        credentials: "include",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });

                    const text = await response.text();
                    const data = text ? JSON.parse(text) : null;

                    if (!response.ok) {
                        throw new Error(data?.message || "Login failed");
                    }

                    window.location.href = "/admin";
                } catch (e) {
                    alertBox.textContent = e.message;
                    alertBox.classList.remove("d-none");
                }
            });

            adminRegisterForm?.addEventListener("submit", async (event) => {
                event.preventDefault();
                alertBox.classList.add("d-none");

                const payload = Object.fromEntries(new FormData(adminRegisterForm).entries());

                try {
                    const response = await fetch("/api/auth/admin-register", {
                        method: "POST",
                        credentials: "include",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });

                    const text = await response.text();
                    const data = text ? JSON.parse(text) : null;

                    if (!response.ok) {
                        throw new Error(data?.message || "Admin registration failed");
                    }

                    alertBox.classList.remove("alert-danger");
                    alertBox.classList.add("alert-success");
                    alertBox.textContent = "Admin account created. You can sign in now.";
                    alertBox.classList.remove("d-none");
                    adminRegisterForm.reset();
                } catch (e) {
                    alertBox.classList.remove("alert-success");
                    alertBox.classList.add("alert-danger");
                    alertBox.textContent = e.message;
                    alertBox.classList.remove("d-none");
                }
            });
        })();
    </script>
}
