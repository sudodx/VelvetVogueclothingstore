using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Authorization;
using System.Diagnostics;
using Microsoft.EntityFrameworkCore;
using VelvetVogueclothingstore.Data;
using VelvetVogueclothingstore.Models;

namespace VelvetVogueclothingstore.Controllers
{
    public class HomeController : Controller
    {
        private readonly ApplicationDbContext _db;

        public HomeController(ApplicationDbContext db)
        {
            _db = db;
        }

        public IActionResult Index()
        {
            return View("Home", BuildHomeViewModel());
        }

        public IActionResult Home()
        {
            return View(BuildHomeViewModel());
        }

        public IActionResult Products()
        {
            return View();
        }

        public IActionResult Cart()
        {
            return View();
        }

        public IActionResult Account()
        {
            return View();
        }

        public IActionResult Orders()
        {
            return View();
        }

        [Authorize(Policy = "AdminOnly")]
        public IActionResult Admin()
        {
            return View();
        }

        [HttpGet("system-admin/signin")]
        public IActionResult AdminLogin()
        {
            if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
            {
                return RedirectToAction("Index");
            }

            return View();
        }

        public IActionResult Privacy()
        {
            return View();
        }

        [ResponseCache(Duration = 0, Location = ResponseCacheLocation.None, NoStore = true)]
        public IActionResult Error()
        {
            return View(new ErrorViewModel { RequestId = Activity.Current?.Id ?? HttpContext.TraceIdentifier });
        }

        private HomeViewModel BuildHomeViewModel()
        {
            var featuredProducts = _db.Products
                .AsNoTracking()
                .OrderBy(p => p.Id)
                .Take(8)
                .ToList();

            var categories = _db.Products
                .AsNoTracking()
                .Where(p => !string.IsNullOrWhiteSpace(p.Category))
                .Select(p => p.Category)
                .Distinct()
                .OrderBy(c => c)
                .Take(10)
                .ToList();

            return new HomeViewModel
            {
                Categories = categories,
                FeaturedProducts = featuredProducts,
                HeroSlides =
                [
                    new HeroSlideViewModel
                    {
                        Title = "10% Off Your First Order",
                        Subtitle = "Fashionable Dress",
                        ImageUrl = "https://images.unsplash.com/photo-1445205170230-053b83016050?w=1400"
                    },
                    new HeroSlideViewModel
                    {
                        Title = "Latest Collection",
                        Subtitle = "Reasonable Price",
                        ImageUrl = "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=1400"
                    }
                ]
            };
        }
    }
}
