@{
    ViewData["Title"] = "Admin";
}

<h2 class="mb-3">Admin Panel</h2>
<div id="adminAlert" class="alert alert-info d-none"></div>

<div class="row g-3 mb-4" id="adminOverview"></div>

<div class="card mb-4">
    <div class="card-body">
        <h5>Add Product</h5>
        <form id="adminProductForm" class="row g-2">
            <div class="col-md-6"><input class="form-control" name="name" placeholder="Name" required /></div>
            <div class="col-md-6"><input class="form-control" name="category" placeholder="Category" required /></div>
            <div class="col-md-6"><input class="form-control" name="gender" placeholder="Gender" required /></div>
            <div class="col-md-6"><input class="form-control" name="size" placeholder="Size" required /></div>
            <div class="col-md-6"><input class="form-control" name="color" placeholder="Color" required /></div>
            <div class="col-md-6"><input class="form-control" name="stock" type="number" min="0" placeholder="Stock" required /></div>
            <div class="col-md-6"><input class="form-control" name="price" type="number" min="0" step="0.01" placeholder="Price" required /></div>
            <div class="col-md-6"><input class="form-control" name="imageUrl" placeholder="Image URL" required /></div>
            <div class="col-12"><textarea class="form-control" name="description" rows="2" placeholder="Description" required></textarea></div>
            <div class="col-12 d-grid d-md-block"><button class="btn btn-dark" type="submit">Create Product</button></div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5>Orders Management</h5>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="adminOrdersBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5>Active Cart Items</h5>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Line Total</th>
                    </tr>
                </thead>
                <tbody id="adminCartBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/store.js" asp-append-version="true"></script>
    <script>
        window.StoreApp.initAdminPage();
    </script>
}
