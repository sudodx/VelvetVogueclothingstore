@{
    ViewData["Title"] = "Cart";
}

<h2 class="mb-3">Your Cart</h2>
<div id="cartAlert" class="alert alert-info d-none"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-responsive">
            <table class="table table-bordered align-middle cart-items-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:40%">Products</th>
                        <th style="width:12%">Size</th>
                        <th style="width:12%">Price</th>
                        <th style="width:18%">Quantity</th>
                        <th style="width:12%">Total</th>
                        <th style="width:6%">Remove</th>
                    </tr>
                </thead>
                <tbody id="cartItemsBody"></tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="input-group mb-3">
            <input id="couponCode" class="form-control" placeholder="Coupon Code" />
            <button id="applyCouponBtn" class="btn btn-outline-secondary" type="button">Apply Coupon</button>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h4 class="mb-0">Cart Summary</h4>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <span>Subtotal</span>
                    <strong>$<span id="cartSubtotal">0.00</span></strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span>Shipping</span>
                    <strong>$<span id="cartShipping">0.00</span></strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-semibold mb-3">
                    <span>Total</span>
                    <span>$<span id="cartTotal">0.00</span></span>
                </div>
                <button id="checkoutBtn" class="btn btn-dark w-100 py-2">Proceed To Checkout</button>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Checkout</h5>
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <label class="form-label">Recipient Name</label>
                <input id="checkoutRecipientName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone Number</label>
                <input id="checkoutPhoneNumber" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Address Line 1</label>
                <input id="checkoutLine1" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Address Line 2</label>
                <input id="checkoutLine2" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">City</label>
                <input id="checkoutCity" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">State</label>
                <input id="checkoutState" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Postal Code</label>
                <input id="checkoutPostalCode" class="form-control" />
            </div>
            <div class="col-md-8">
                <label class="form-label">Country</label>
                <input id="checkoutCountry" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="checkoutDefaultShipping" />
                    <label class="form-check-label" for="checkoutDefaultShipping">Set as default</label>
                </div>
            </div>
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Shipping Address</label>
                <select id="checkoutAddress" class="form-select"></select>
            </div>
            <div class="col-md-2 d-grid">
                <button id="saveCheckoutAddressBtn" class="btn btn-outline-dark" type="button">Save</button>
            </div>
        </div>
        <small class="text-muted d-block mt-2">Select an address to edit it or fill fields and click Save to add a new one.</small>
    </div>
</div>

@section Scripts {
    <script src="~/js/store.js" asp-append-version="true"></script>
    <script>
        window.StoreApp.initCartPage();
    </script>
}
