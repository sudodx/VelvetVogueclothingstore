@{
    ViewData["Title"] = "Cart";
}

<h2 class="mb-3">Your Cart</h2>
<div id="cartAlert" class="alert alert-info d-none"></div>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="cartItemsBody"></tbody>
    </table>
</div>
<div class="text-end fs-5 fw-semibold">Grand Total: $<span id="cartTotal">0.00</span></div>

@section Scripts {
    <script src="~/js/store.js" asp-append-version="true"></script>
    <script>
        window.StoreApp.initCartPage();
    </script>
}
